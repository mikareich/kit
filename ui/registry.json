{
	"$schema": "https://ui.shadcn.com/schema/registry.json",
	"items": [
		{
			"author": "Mika Reich <mika@reich.re>",
			"dependencies": [
				"@radix-ui/react-icons",
				"@radix-ui/react-slot",
				"class-variance-authority",
				"react"
			],
			"description": "The Button primitive.",
			"docs": "https://kit.reich.re/docs/components/button",
			"files": [
				{
					"path": "./src/button.tsx",
					"target": "@ui/button.tsx",
					"type": "registry:ui"
				}
			],
			"name": "button",
			"registryDependencies": ["mikareich/kit/base"],
			"title": "Button",
			"type": "registry:ui"
		},
		{
			"author": "Mika Reich <mika@reich.re>",
			"dependencies": ["tailwindcss"],
			"description": "Theme styles and Tailwind utilities.",
			"docs": "https://kit.reich.re/docs/theming",
			"files": [
				{
					"path": "./src/theme.css",
					"target": "@components/theme.css",
					"type": "registry:style"
				}
			],
			"name": "theme",
			"title": "Theme",
			"type": "registry:style"
		}
	],
	"name": "ui"
}
