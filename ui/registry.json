{
	"$schema": "https://ui.shadcn.com/schema/registry.json",
	"items": [
		{
			"author": "Mika Reich <mika@reich.re>",
			"dependencies": [
				"@radix-ui/react-icons",
				"@radix-ui/react-slot",
				"class-variance-authority",
				"react"
			],
			"description": "The Button primitive.",
			"docs": "https://kit.reich.re/docs/components/button",
			"files": [
				{
					"path": "./button.tsx",
					"target": "@ui/button.tsx",
					"type": "registry:ui"
				}
			],
			"name": "button",
			"registryDependencies": ["mikareich/kit/base"],
			"title": "Button",
			"type": "registry:ui"
		},
		{
			"author": "Mika Reich <mika@reich.re>",
			"dependencies": ["class-variance-authority", "react"],
			"description": "The Input primitive.",
			"docs": "https://kit.reich.re/docs/components/input",
			"files": [
				{
					"path": "./input.tsx",
					"target": "@ui/input.tsx",
					"type": "registry:ui"
				}
			],
			"name": "input",
			"registryDependencies": ["mikareich/kit/base"],
			"title": "Input",
			"type": "registry:ui"
		},
		{
			"author": "Mika Reich <mika@reich.re>",
			"dependencies": ["@radix-ui/react-slot", "next", "react"],
			"description": "A layout primitive for composing navigation bars, headers, and footers.",
			"docs": "https://kit.reich.re/docs/components/app-bar",
			"files": [
				{
					"path": "./app-bar.tsx",
					"target": "@ui/app-bar.tsx",
					"type": "registry:ui"
				}
			],
			"name": "app-bar",
			"registryDependencies": ["mikareich/kit/base"],
			"title": "App Bar",
			"type": "registry:ui"
		},
		{
			"author": "Mika Reich <mika@reich.re>",
			"dependencies": ["tailwindcss"],
			"description": "Theme styles and Tailwind utilities.",
			"docs": "https://kit.reich.re/docs/theming",
			"files": [
				{
					"path": "./theme.css",
					"target": "@components/theme.css",
					"type": "registry:style"
				}
			],
			"name": "theme",
			"title": "Theme",
			"type": "registry:style"
		}
	],
	"name": "ui"
}
