{
	"$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
	"assist": {
		"actions": {
			"source": {
				"preset": "all",
				"useSortedPackageJson": "off"
			}
		},
		"enabled": true
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"files": {
		"ignoreUnknown": true
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"domains": {
			"drizzle": "recommended",
			"next": "recommended",
			"react": "recommended",
			"solid": "none",
			"tailwind": "recommended"
		},
		"enabled": true
	},
	"overrides": [
		{
			"includes": ["*.config.(ts,js)"],
			"linter": {
				"rules": {
					"style": {
						"noDefaultExport": "off"
					}
				}
			}
		}
	],
	"root": false,
	"vcs": {
		"clientKind": "git",
		"enabled": true,
		"useIgnoreFile": true
	}
}
