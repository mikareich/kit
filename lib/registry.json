{
	"$schema": "https://ui.shadcn.com/schema/registry.json",
	"items": [
		{
			"author": "Mika Reich <mika@reich.re>",
			"dependencies": ["clsx", "tailwind-merge"],
			"description": "Utility for conditionally merging class names.",
			"docs": "https://kit.reich.re/",
			"files": [
				{
					"path": "./cn.ts",
					"target": "@lib/cn.ts",
					"type": "registry:lib"
				}
			],
			"name": "cn",
			"title": "cn",
			"type": "registry:lib"
		},
		{
			"author": "Mika Reich <mika@reich.re>",
			"description": "Shared base configuration for Biome.",
			"devDependencies": ["@biomejs/biome"],
			"docs": "https://kit.reich.re/",
			"files": [
				{
					"path": "./biome-base.json",
					"target": "~/biome.json",
					"type": "registry:file"
				}
			],
			"name": "biome",
			"title": "Biome",
			"type": "registry:item"
		}
	],
	"name": "lib"
}
