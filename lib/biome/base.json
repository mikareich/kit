{
	"$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": "on",
			"complexity": "on",
			"correctness": {
				"preset": "all",
				"noNodejsModules": "off"
			},
			"nursery": "on",
			"performance": "on",
			"security": "on",
			"style": "on",
			"suspicious": "on"
		},
		"domains": {
			"next": "all",
			"tailwind": "all",
			"react": "all",
			"drizzle": "all"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"files": {
		"ignoreUnknown": true
	},
	"vcs": {
		"clientKind": "git",
		"enabled": true,
		"useIgnoreFile": true
	},
	"root": false
}
