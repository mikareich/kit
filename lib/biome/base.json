{
	"$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
	"assist": {
		"actions": {
			"source": {
				"preset": "all",
				"useSortedPackageJson": "off"
			}
		},
		"enabled": true
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"files": {
		"ignoreUnknown": true
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"domains": {
			"drizzle": "all",
			"next": "all",
			"react": "all",
			"solid": "none",
			"tailwind": "all"
		},
		"enabled": true,
		"rules": {
			"a11y": "on",
			"complexity": "on",
			"correctness": {
				"noNodejsModules": "off",
				"preset": "all"
			},
			"nursery": "on",
			"performance": "on",
			"preset": "recommended",
			"security": "on",
			"style": "on",
			"suspicious": {
				"noConsole": "info",
				"preset": "all"
			}
		}
	},
	"root": false,
	"vcs": {
		"clientKind": "git",
		"enabled": true,
		"useIgnoreFile": true
	}
}
